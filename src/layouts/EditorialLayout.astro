---
import { originalCSS, faviconTags, headerHtml, footerHtml } from '../lib/original';
interface Props {
  title: string;
  description: string;
  image?: string;
  datePublished?: Date;
}
const { title, description, image, datePublished } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title + ' | Joshua Mahony';
const socialImage = new URL(image || '/uploads/portrait-photo.jpg', Astro.site).toString();
const isArticle = Boolean(datePublished);
const jsonLd = isArticle ? {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: title,
  description,
  mainEntityOfPage: canonical.toString(),
  datePublished: datePublished!.toISOString(),
  author: { '@type': 'Person', name: 'Joshua Mahony', url: 'https://joshua-mahony.com/' },
  publisher: { '@type': 'Person', name: 'Joshua Mahony', url: 'https://joshua-mahony.com/' },
  image: socialImage
} : {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description,
  url: canonical.toString()
};
const menuScript = `
  (() => {
    const button = document.getElementById('menu-toggle');
    const nav = document.getElementById('primary-nav');
    if (!button || !nav) return;
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(open));
      button.textContent = open ? '×' : '☰';
      nav.classList.toggle('is-open', open);
    });
    nav.querySelectorAll('a').forEach(a => a.addEventListener('click', () => nav.classList.remove('is-open')));
  })();
`;
---
<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#102033" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.toString()} />
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:site_name" content="Joshua Mahony" />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={image ? title : 'Joshua Mahony, financial market analyst and broadcast commentator'} />
    {isArticle && <meta property="article:published_time" content={datePublished!.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@JoshuaMahony" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
    <Fragment set:html={faviconTags} />
    <Fragment set:html={'<style>' + originalCSS + '</style>'} />
    <style is:global>
      .editorial-wrap { max-width: 850px; width: calc(100% - 48px); margin: 0 auto; padding: 74px 0 100px; }
      .editorial-back { color: #92754d; font-size: 13px; font-weight: 700; }
      .editorial-label { margin-top: 50px; font-size: 12px; text-transform: uppercase; letter-spacing: .16em; color: #977c55; font-weight: 800; }
      .editorial-title { font: 400 clamp(38px,6vw,66px)/1.09 Georgia,serif; letter-spacing: -.045em; margin: 18px 0 24px; }
      .editorial-summary { font-size: 19px; color: #536376; line-height: 1.7; max-width: 700px; }
      .editorial-byline { font-size: 13px; color: #68798b; margin: 26px 0 34px; }
      .editorial-hero { width: 100%; height: auto; max-height: 540px; object-fit: cover; margin: 0 0 35px; }
      .editorial-body { max-width: 710px; font-size: 17px; line-height: 1.85; color: #283b4d; overflow-wrap: anywhere; }
      .editorial-body h2, .editorial-body h3 { color: #102033; font: 400 32px/1.2 Georgia,serif; margin: 43px 0 16px; }
      .editorial-body h3 { font-size: 25px; }
      .editorial-body p { margin: 0 0 24px; }
      .editorial-body a { color: #8e6e3f; text-decoration: underline; }
      .editorial-body img { display: block; max-width: 100%; height: auto; margin: 29px 0; }
      .editorial-body blockquote { border-left: 3px solid #b29a70; padding-left: 22px; margin: 30px 0; color: #536376; }
      .editorial-body figcaption, .editorial-body em { color: #536376; }
      .editorial-body ul, .editorial-body ol { margin-bottom: 25px; }
      .archive-entry { padding: 25px 0; border-bottom: 1px solid #e2e7e8; }
      .archive-entry h2 { font: 400 29px/1.23 Georgia,serif; margin: 8px 0; }
      .archive-entry h2 a:hover { text-decoration: underline; }
      .archive-entry p { color: #536376; margin: 0; }
      .archive-meta { font-size: 12px; color: #987b56; text-transform: uppercase; letter-spacing: .07em; }
      @media(max-width: 600px) {
        .editorial-wrap { width: calc(100% - 36px); padding: 32px 0 58px; }
        .editorial-label { margin-top: 34px; }
        .editorial-title { font-size: clamp(34px, 9vw, 44px); line-height: 1.13; overflow-wrap: break-word; }
        .editorial-summary { font-size: 17px; line-height: 1.62; }
        .editorial-body { font-size: 16px; line-height: 1.7; }
        .editorial-body h2 { font-size: 27px; }
        .editorial-body h3 { font-size: 22px; }
        .editorial-body a, .editorial-back { overflow-wrap: anywhere; }
        .archive-entry h2 { font-size: 25px; overflow-wrap: break-word; }
      }
      @media(max-width: 380px) {
        .editorial-title { font-size: 33px; }
        .editorial-wrap { width: calc(100% - 32px); }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Fragment set:html={headerHtml} />
    <main id="main">
      <slot />
    </main>
    <Fragment set:html={footerHtml} />
    <script is:inline set:html={menuScript} />
  </body>
</html>
