---
import homepage from '../data/homepage.json';

interface Props {
  heading: string;
  description?: string;
  type: 'broadcast' | 'creator' | 'analysis';
}

const { heading, description, type } = Astro.props;
const videos = homepage.broadcasts.filter((item) =>
  type === 'broadcast' ? item.type === 'broadcast'
    : type === 'creator' ? item.type === 'longform' || item.type === 'short'
    : item.type === 'longform'
);
const format = (value: string) => value === 'broadcast' ? 'TV interview' : value === 'short' ? 'Short-form video' : 'Long-form video';
const validLink = (value: string) => {
  try {
    const url = new URL(value);
    return url.protocol === 'https:' ? value : undefined;
  } catch {
    return undefined;
  }
};
---
{videos.length > 0 && (
  <section class="showcase" aria-label={heading}>
    <div class="editorial-label">Selected work</div>
    <h2 class="showcase-heading">{heading}</h2>
    {description && <p class="showcase-intro">{description}</p>}
    <div class="showcase-grid">
      {videos.map((video) => (
        <article class="showcase-card">
          {validLink(video.url) ? (
            <a class="showcase-thumb" href={validLink(video.url)} target="_blank" rel="noopener noreferrer" aria-label={`Watch ${video.title} on ${video.network}`}>
              {video.thumbnail ? <img src={video.thumbnail} alt="" loading="lazy" /> : <span class="showcase-placeholder">{video.network}</span>}
              <span class="showcase-play" aria-hidden="true">▶</span>
            </a>
          ) : (
            <div class="showcase-thumb">
              {video.thumbnail && <img src={video.thumbnail} alt="" loading="lazy" />}
            </div>
          )}
          <div class="showcase-meta">{video.network} · {format(video.type)}</div>
          <h3>{video.title}</h3>
          <p>{video.summary}</p>
          {validLink(video.url) && <a class="showcase-link" href={validLink(video.url)} target="_blank" rel="noopener noreferrer">Watch video ↗</a>}
        </article>
      ))}
    </div>
    <p class="showcase-more"><a href="/#broadcasts">Explore the full video portfolio ↗</a></p>
  </section>
)}
<style>
  .showcase { margin-top: 60px; border-top: 1px solid #e2e7e8; padding-top: 26px; }
  .showcase-heading { font: 400 clamp(28px,4vw,38px)/1.2 Georgia,serif; letter-spacing: -.025em; color: #102033; margin: 14px 0; }
  .showcase-intro { color: #536376; line-height: 1.65; margin: 0 0 25px; }
  .showcase-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 28px 22px; }
  .showcase-card { min-width: 0; }
  .showcase-thumb { display: block; position: relative; width: 100%; aspect-ratio: 16 / 9; background: #102033; overflow: hidden; border-radius: 5px; }
  .showcase-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .2s ease; }
  .showcase-thumb:hover img { transform: scale(1.025); }
  .showcase-placeholder { color: #fff; display: grid; place-items: center; height: 100%; }
  .showcase-play { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); display: grid; place-items: center; background: rgba(16,32,51,.85); border: 1px solid rgba(255,255,255,.6); color: white; border-radius: 100%; width: 52px; height: 52px; font-size: 17px; padding-left: 3px; }
  .showcase-meta { color: #92754d; font-size: 12px; font-weight: 700; margin-top: 13px; }
  .showcase-card h3 { font: 400 23px/1.25 Georgia,serif; color: #102033; margin: 7px 0 9px; }
  .showcase-card p { color: #536376; font-size: 14px; line-height: 1.6; margin: 0 0 10px; }
  .showcase-link,.showcase-more a { color: #8e6e3f; text-decoration: underline; font-size: 14px; font-weight: 700; }
  .showcase-more { margin: 24px 0 0; }
  @media (max-width:600px) { .showcase-grid { grid-template-columns: 1fr; gap: 30px; } }
</style>
